{
    "id": "ca.wordtsar.WordTsar",
    "runtime": "org.kde.Platform",
    "runtime-version": "5.15-22.08",
    "sdk": "org.kde.Sdk//5.15-22.08",
    "command": "WordTsar",
    "rename-icon": "wordtsar",
    "rename-desktop-file": "WordTsar.desktop",
    "finish-args": [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--share=ipc"
    ],
    "modules": [
        {
            "name": "wordtsar",
            "buildsystem": "qmake",
            "builddir": true,
            "post-install": [
                "install -Dm755 WordTsar -t /app/bin",
                "install -Dm644 ../linuxdeploy/wordtsar.png -t /app/share/icons/hicolor/128x128/apps",
                "install -Dm644 ../linuxdeploy/WordTsar.desktop -t /app/share/applications"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://downloads.sourceforge.net/project/wordtsar/Releases/WordTsar-0.3.719/WordTsar-0.3.719-src.zip",
                    "sha256": "b42e134b209a8a2f94f07d69b1a5f302c9620435dc14d654a3c245904c0f9178"
                }
            ]
        }
    ]
}
