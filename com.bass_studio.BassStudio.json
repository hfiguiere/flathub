{
    "id": "com.bass_studio.BassStudio",
    "runtime": "org.freedesktop.Platform",
    "sdk": "org.freedesktop.Sdk//22.08",
    "runtime-version": "22.08",
    "sdk-extensions" : [
        "org.freedesktop.Sdk.Extension.llvm14"
    ],
    "command": "DAW",
    "finish-args": [
        "--share=ipc",
        "--socket=x11",
        "--device=dri",
        "--filesystem=home"
    ],
    "build-options":{
        "append-path": "/usr/lib/sdk/llvm14/bin",
        "prepend-ld-library-path": "/usr/lib/sdk/llvm14/lib"
    },
    "modules": [
        {
            "name": "bass-studio",
            "buildsystem": "simple",
            "build-options": {
                "cxxflags": "-Wno-error=restrict",
                "arch": {
                    "aarch64": {
                        "env": {
                            "CFG_OPTIMIZE": "-DPROJECT_CFG_OPTIMIZE=OFF"
                        }
                    }
                }
            },
            "build-commands": [
                "mkdir build-deps",
                "cd build-deps && python ../daw-deps/build.py",
                "cd bass-studio && cmake -G Ninja -DCMAKE_BUILD_TYPE=RelWithDebInfo $CFG_OPTIMIZE -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++ -DPROJECT_DEPS_PATH=../daw-deps -S. -Bbuild --install-prefix=/app && ninja -C build",
                "install -Dm755 bass-studio/build/dist/DAW -t /app/bin",
                "cp -R bass-studio/build/dist/res /app/bin/res",
                "install -Dm644 bass-studio/res/svg/daw-logo.svg /app/share/icons/hicolor/scalable/apps/${FLATPAK_ID}.svg",
                "install -Dm644 com.bass_studio.BassStudio.desktop -t /app/share/applications",
                "install -Dm644 com.bass_studio.BassStudio.appdata.xml -t /app/share/appdata"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/hfiguiere/daw-deps.git",
                    "commit": "c5b59fb2c2b4b199ec877e49937f355c30d61c78",
                    "dest": "daw-deps"
                },
                {
                    "type": "git",
                    "url": "https://github.com/nidefawl/bass-studio.git",
                    "tag": "v5.0.15",
                    "dest": "bass-studio"
                },
                {
                    "type": "patch",
                    "path": "patches/aarch64-build.patch",
                    "options": [
                        "-d",
                        "daw-deps"
                    ]
                },
                {
                    "type": "patch",
                    "path": "patches/bassstudio-glm.patch",
                    "options": [
                        "-d",
                        "bass-studio"
                    ]
                },
                {
                    "type": "file",
                    "path": "com.bass_studio.BassStudio.appdata.xml"
                },
                {
                    "type": "file",
                    "path": "com.bass_studio.BassStudio.desktop"
                }
            ]
        }
    ]
}
